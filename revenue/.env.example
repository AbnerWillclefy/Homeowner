# Build-time configuration of Revenue. Every value is baked into the bundle,
# so each environment is its own build. Public: no secrets here.
# `npm run dev` already reads revenue/.env.development (the local API); copy this
# to revenue/.env.local and fill in the Cognito values.

# Base URL of the API. Required.
VITE_API_URL=http://localhost:8080

# Cognito, the same pool and app client as the PWA (web/.env.local). Required.
VITE_COGNITO_REGION=
VITE_COGNITO_CLIENT_ID=

# The pool's password rules, the JSON of Terraform's `cognito_password_policy` output
# (the same value as web/'s VITE_PASSWORD_POLICY). Required: the new-password step of
# "Esqueci a senha" lists the rules from it.
VITE_PASSWORD_POLICY=
