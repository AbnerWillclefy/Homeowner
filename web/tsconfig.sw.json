{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "src/sw.ts",
    "src/sw",
    "src/shared/i18n/locales.ts",
    "src/shared/i18n/resolveLocale.ts",
    "src/shared/i18n/fallback.ts",
    "src/shared/i18n/browserLanguages.ts"
  ]
}
