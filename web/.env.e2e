# Public dummy values for the Playwright build (npm run build:e2e). No secrets.
# The API host is unresolvable on purpose: a request no fake covers fails instead of reaching a real server.
VITE_API_BASE_URL=https://api.e2e.test
VITE_COGNITO_REGION=eu-west-1
VITE_COGNITO_CLIENT_ID=e2eclientid
VITE_PASSWORD_POLICY={"minimum_length":10,"require_lowercase":true,"require_uppercase":true,"require_numbers":true,"require_symbols":false}
# Pluggy Connect: the e2e build loads a stub from the fake CDN (e2e/mocks/pluggyCdn.ts) and keeps `integrity` on, with
# the stub's own hash. Production builds set neither and use the pinned script of ADR 0019. A spec fails if the hash drifts.
VITE_PLUGGY_CONNECT_URL=https://cdn.pluggy.test/pluggy-connect.js
VITE_PLUGGY_CONNECT_SRI=sha384-kY6uGaPNgyuD1pO14M5p+N9ag+W5Kw8QuMqMioBFhCDCvIYDPBosIEIu6/6E+4ZA
