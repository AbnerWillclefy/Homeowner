# Base URL of the API. Required; baked into the bundle at build time, so every
# environment (staging, production) is its own build. Public: no secrets here.
# `npm run dev` already reads web/.env.development; copy this to web/.env.local
# to override it locally.
VITE_API_BASE_URL=http://localhost:8080

# Sign-in (Cognito). Both required; baked into the bundle at build time. Public
# identifiers, not secrets: the app client has no secret. For local development
# use the staging pool's values (`terraform output` in infra/staging:
# cognito_region and cognito_client_id) or your own pool; see the README, Run
# everything locally. The deploy sets them for staging builds.
VITE_COGNITO_REGION=
VITE_COGNITO_CLIENT_ID=

# Password rules, as the one-line JSON the user pool enforces, so the sign-up
# text and minimum length follow Terraform. Required; baked in at build time.
# Public. Copy it from `terraform output cognito_password_policy` in
# infra/staging (the auth module's password_policy output). The deploy sets it
# for staging builds. Existing web/.env.local files need this line.
VITE_PASSWORD_POLICY={"minimum_length":10,"require_lowercase":true,"require_uppercase":true,"require_numbers":true,"require_symbols":false}

# Optional. Set to the literal string true to show the staging-only "Replan now"
# button on the Day Plan (it calls POST /dev/replan, which only exists on
# staging). Leave unset for production builds.
# VITE_REPLAN_ENABLED=true
