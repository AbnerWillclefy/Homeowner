# Build-time configuration of the admin app. Every value is baked into the bundle,
# so each environment is its own build. Public: no secrets here.
# `npm run dev` already reads admin/.env.development (local, port 5174); copy this
# to admin/.env.local to override it. Put the Cognito values in admin/.env.local.

# Which environment this build is: local, staging or production. Required. It must
# match the API's ENVIRONMENT; the app shows an error banner if they disagree.
VITE_ENVIRONMENT=local

# Base URL of the API. Required. (The PWA's equivalent is called VITE_API_BASE_URL.)
VITE_API_URL=http://localhost:8080

# Cognito, the same pool and app client as the PWA (web/.env.local). Required.
VITE_COGNITO_REGION=
VITE_COGNITO_CLIENT_ID=

# Where each environment's admin app lives, as a JSON object from environment name
# to origin (https, or http for localhost). Optional: empty or partial is valid, and
# the environment switch then shows "<Environment> URL not configured".
VITE_ADMIN_URLS={"local":"http://localhost:5174"}
