# Optional: docker-compose.yml has a default for every variable.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=homeowner
DB_PORT=5432
API_PORT=8080

# Used by `go test ./...` (admin database; tests create and drop their own).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# Sign-in for the API. Optional as a pair; empty means auth is off and /me
# answers 503. Same pool and client as web/.env.local (see README, Run
# everything locally). The issuer is https://cognito-idp.<region>.amazonaws.com/<pool id>.
COGNITO_ISSUER=
COGNITO_CLIENT_ID=

# Web Push. Optional; empty means push is off and /push/* answers 503.
# Generate a pair with `cd backend && go run ./cmd/api vapid`. Keep the private key local.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
